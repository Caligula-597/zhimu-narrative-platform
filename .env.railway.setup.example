# 复制为 .env.railway.setup（已 gitignore）

# ── Account Token：本地 bootstrap 用 ──
# 创建：https://railway.com/account/tokens
RAILWAY_ACCOUNT_TOKEN=

# ── Project Token：GitHub Actions 用（填到 GitHub Secret RAILWAY_TOKEN）──
# 创建：Railway 项目 beautiful-unity → Settings → Tokens
# RAILWAY_PROJECT_TOKEN=   （不要写进本文件提交；直接 gh secret set 或 GitHub 网页）

# bootstrap 读取 RAILWAY_TOKEN 或 RAILWAY_ACCOUNT_TOKEN
RAILWAY_TOKEN=

# RAILWAY_PROJECT_ID=26f5bb70-1688-4e0b-a414-5c03f16ed95b
APP_PUBLIC_URL=https://getzhimu.com
API_PUBLIC_URL=https://api.getzhimu.com
