# 复制为 .env.railway.setup（已 gitignore），填一次后运行 npm run railway:bootstrap
#
# Token: https://railway.com/account/tokens → Create Token（Account Token 即可）

RAILWAY_TOKEN=

# 可选 — 不填则自动匹配名称含 zhimu 的项目
# RAILWAY_PROJECT_ID=

# 可选 — 不填则按服务名猜测 api / web
# RAILWAY_API_SERVICE_ID=
# RAILWAY_WEB_SERVICE_ID=

# 生产域名（脚本会写入 Railway Variables）
APP_PUBLIC_URL=https://getzhimu.com
API_PUBLIC_URL=https://api.getzhimu.com

# 设为 false 则只写配置、不触发 Web 部署
# RAILWAY_DEPLOY=true
