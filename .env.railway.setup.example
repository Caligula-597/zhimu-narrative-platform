# 复制为 .env.railway.setup（已 gitignore）

# ── Account Token（免费版一般有）──
# 创建：https://railway.com/account/tokens
# 用于：npm run railway:bootstrap / railway:push-env
RAILWAY_ACCOUNT_TOKEN=

# bootstrap 也读 RAILWAY_TOKEN（二选一）
RAILWAY_TOKEN=

# ── Project Token（免费版通常没有，可跳过）──
# 可选：GitHub Secret RAILWAY_TOKEN → railway up
# RAILWAY_PROJECT_TOKEN=

# GitHub Actions Deploy 工作流（无 Project Token 时用 Account Token 触发 redeploy）
# Secret 名：RAILWAY_ACCOUNT_TOKEN（与上相同 Account Token 即可）
RAILWAY_ENVIRONMENT_ID=e3b187d0-75ba-49a3-ba92-16168dd5fb68

# 固定项目（beautiful-unity）
RAILWAY_PROJECT_ID=26f5bb70-1688-4e0b-a414-5c03f16ed95b
RAILWAY_API_SERVICE_ID=fc78dfb7-98dc-4ca5-8a9e-4cb9a9db80b1

# 单域 fullstack（API 在同域 /api，不再用 api 子域）
APP_PUBLIC_URL=https://app.getzhimu.com
OFFICIAL_EXAMPLE_WORLD_ID=20725d66-35ec-4d2f-aef8-4794cef6ace1

# Cloudflare API（分域迁移 / DNS 同步）
# 创建：https://dash.cloudflare.com/profile/api-tokens
# 权限：Zone DNS Edit + Cloudflare Pages Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
