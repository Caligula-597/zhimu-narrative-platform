{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "web/Dockerfile",
    "watchPatterns": [
      "web/**",
      "config/**",
      "src/**",
      "frontend/**",
      "docs/**",
      "index.html",
      "app.js",
      "config.js",
      "dom.js",
      "state.js",
      "styles.css",
      "rule-visual.js",
      "server.js",
      "package.json"
    ]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
