          "role_a"
        ],
        "visibility": "PRIVATE"
      },
      "delivery": "AUTO_ON_STAGE",
      "content": "你是商会书记沈孤鸿。昨夜你在库房门口见过一个模糊身影。\n你需要先弄清昨夜争执的起因。",
      "title": "沈孤鸿·第一幕",
      "sourceRef": {
        "sourceType": "CHARACTER_SCRIPT",
        "sourceDocumentId": "doc_role_a",
        "characterId": "role_a",
