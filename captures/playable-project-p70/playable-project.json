      "audience": {
        "roleIds": [
          "role_b"
        ],
        "visibility": "PRIVATE"
      },
      "delivery": "AUTO_ON_STAGE",
      "content": "你不希望任何人进入库房。你会尽量阻止竞价，或确保赢家不是赵启明。",
      "title": "陆晚晴·第二幕",
      "sourceRef": {
        "sourceType": "CHARACTER_SCRIPT",
        "sourceDocumentId": "doc_role_b",
