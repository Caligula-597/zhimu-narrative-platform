# Fullstack: Vite frontend + Fastify API in ONE Railway service (no extra Web service).
FROM node:24.13.0-alpine AS web-build
WORKDIR /web
COPY package.json package-lock.json ./
COPY config ./config
COPY src ./src
COPY docs ./docs
COPY frontend ./frontend
COPY index.html app.js config.js styles.css rule-visual.js ./
COPY shared ./shared
RUN npm ci --no-audit --no-fund
ENV VITE_API_BASE=/api
ENV VITE_REQUIRE_AUTH=true
ENV VITE_DEMO_MODE=false
RUN npm run build

FROM node:24.13.0-alpine AS api
WORKDIR /app

COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY backend/ .
RUN sed -i 's/\r$//' ./deploy/docker-entrypoint-api.sh \
  && chmod +x ./deploy/docker-entrypoint-api.sh
# room/platform event schemas resolve ../../shared from /app/src → /shared
COPY shared /shared
COPY --from=web-build /web/dist ./public/dist

ENV NODE_ENV=production
ENV SERVE_STATIC=true
ENV STATIC_ROOT=/app/public/dist
EXPOSE 4180

ENTRYPOINT ["sh", "./deploy/docker-entrypoint-api.sh"]
