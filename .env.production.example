# =============================================================================
# 织幕 · Docker 预发 / 生产编排环境变量（根目录）
# =============================================================================
# 使用方式：
#   Copy-Item .env.production.example .env.staging
#   npm run staging:sync-env   # 从 backend/.env 同步密钥到 .env.staging
# 详见 docs/ops/STAGING.md 与 docs/ops/COMMERCIAL_EXTERNAL_SERVICES.md
# =============================================================================

# 对外 HTTP 端口（nginx）
STAGING_HTTP_PORT=8080

# Postgres（Docker 内置，生产可换托管库并改 backend DATABASE_URL）
POSTGRES_USER=zhimu
POSTGRES_PASSWORD=
POSTGRES_DB=zhimu

# 以下由 staging:sync-env 从 backend/.env 写入，也可手动填写：
# DATABASE_URL=postgresql://zhimu:xxx@postgres:5432/zhimu
# APP_PUBLIC_URL=http://localhost:8080
# RESEND_API_KEY=
# MAIL_FROM=
# EMAIL_PROVIDER=resend
# REQUIRE_EMAIL_VERIFICATION=false
