{
  "name": "zhimu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.mjs",
    "build": "vite build --config config/vite.config.mjs",
    "build:staging": "vite build --mode staging --config config/vite.config.mjs",
    "preview": "vite preview --config config/vite.config.mjs",
    "start": "node server.js",
    "start:dist": "node server.js --dist",
    "staging:up": "npm run build:staging && docker compose -p zhimu-staging -f docker-compose.staging.yml --env-file .env.staging up -d --build",
    "staging:rebuild-api": "docker compose -p zhimu-staging -f docker-compose.staging.yml --env-file .env.staging build --no-cache api && docker compose -p zhimu-staging -f docker-compose.staging.yml --env-file .env.staging up -d api && docker compose -p zhimu-staging -f docker-compose.staging.yml --env-file .env.staging exec api sh -c \"node scripts/migrate.js\"",
    "staging:down": "docker compose -p zhimu-staging -f docker-compose.staging.yml --env-file .env.staging down",
    "staging:logs": "docker compose -p zhimu-staging -f docker-compose.staging.yml --env-file .env.staging logs -f api",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "staging:isolation-smoke": "node scripts/staging-isolation-smoke.mjs",
    "accept:clue-audit": "node scripts/clue-audit-acceptance.mjs",
    "staging:e2e": "node scripts/staging-e2e.mjs",
    "staging:sync-env": "node scripts/sync-staging-env.mjs",
    "railway:sync-env": "node scripts/sync-railway-env.mjs",
    "railway:bootstrap": "node scripts/railway-bootstrap.mjs",
    "railway:push-env": "node scripts/railway-push-env.mjs",
    "migrate:split-domains": "node scripts/migrate-split-domains.mjs",
    "migrate:format-bridge": "node scripts/migrate-format-bridge.mjs",
    "migrate:modal-bridge": "node scripts/migrate-modal-bridge.mjs",
    "migrate:ui-bridge": "node scripts/migrate-ui-bridge.mjs",
    "cloudflare:sync-dns": "node scripts/cloudflare-sync-dns.mjs",
    "cloudflare:sync-security": "node scripts/cloudflare-sync-security.mjs",
    "cloudflare:sync-pages": "node scripts/cloudflare-sync-pages.mjs",
    "oauth:check": "node scripts/check-oauth-config.mjs",
    "monitoring:smoke": "node scripts/monitoring-smoke.mjs",
    "pages:smoke": "node scripts/pages-smoke.mjs",
    "domain:security": "node scripts/domain-security-check.mjs",
    "port:doctor": "node scripts/port-doctor.mjs",
    "check:production-ready": "node scripts/check-production-ready.mjs",
    "check:source-encoding": "node scripts/check-source-encoding.mjs",
    "status:generate": "node scripts/generate-project-status.mjs",
    "audit:innerhtml": "node scripts/audit-innerhtml.mjs",
    "audit:periodic": "node scripts/periodic-audit.mjs",
    "audit:periodic:security": "node scripts/periodic-audit.mjs --security",
    "railway:deploy": "node scripts/railway-deploy.mjs",
    "railway:deploy:ci": "node scripts/railway-deploy-ci.mjs",
    "railway:deployment-logs": "node scripts/railway-deployment-logs.mjs",
    "railway:sync-gh-secrets": "node scripts/sync-railway-gh-secrets.mjs",
    "verify:production-release": "node scripts/verify-production-release.mjs",
    "railway:deploy:web": "node scripts/railway-deploy-web.mjs",
    "staging:seed": "docker compose -p zhimu-staging -f docker-compose.staging.yml --env-file .env.staging exec api node scripts/seed.js",
    "staging:cleanup-rooms": "docker compose -p zhimu-staging -f docker-compose.staging.yml --env-file .env.staging exec api node scripts/cleanup-duplicate-rooms.js",
    "check:modules": "node scripts/verify-script-load.mjs",
    "verify:changed": "node scripts/verify-changed.mjs",
    "verify:full": "node scripts/full-chain.mjs",
    "verify:full:fresh": "node scripts/full-chain.mjs --fresh",
    "verify:full:3": "node scripts/verify-full-repeat.mjs --count=3",
    "verify:isolated:3": "node scripts/verify-full-repeat.mjs --count=3",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed",
    "test:format-helpers": "node --test scripts/format-helpers.test.mjs",
    "test:shared-status-chip": "node --test scripts/shared-status-chip.test.mjs",
    "test:shared": "node --test scripts/shared-status-chip.test.mjs scripts/shared-api-fetch.test.mjs scripts/shared-session-token.test.mjs scripts/shared-auth-state.test.mjs scripts/shared-toast.test.mjs scripts/shared-safe-dom.test.mjs scripts/director-modal-templates.test.mjs scripts/writer-modal-templates.test.mjs scripts/publish-impact-preview.test.mjs scripts/shared-sse.test.mjs scripts/shared-sse-lifecycle.test.mjs scripts/sse-fault-matrix.test.mjs scripts/action-dispatch.test.mjs scripts/shared-player-reader.test.mjs scripts/shared-host-stuck.test.mjs scripts/shared-trace-context.test.mjs scripts/shared-web-vitals.test.mjs scripts/shared-api-client.test.mjs scripts/guardian-product-probes.test.mjs scripts/shared-contracts-consume.test.mjs",
    "guardian:poll": "node scripts/guardian-poll.mjs --web-vitals",
    "guardian:poll:local": "node scripts/guardian-poll.mjs --web-vitals --product-probes",
    "guardian:poll:full": "node scripts/guardian-poll.mjs --web-vitals --product-probes --pg-stat",
    "guardian:scheduler": "node scripts/guardian-scheduler.mjs --web-vitals",
    "check:contracts": "node scripts/check-contracts-drift.mjs",
    "check:world-writes": "node scripts/verify-world-write-contracts.mjs",
    "check:architecture": "node scripts/audit-domain-boundaries.mjs",
    "test:modal-helpers": "node --test scripts/modal-helpers.test.mjs",
    "test:ui-semantics": "node --test scripts/ui-semantics.test.mjs",
    "test:runtime-stores": "node --test scripts/runtime-stores.test.mjs",
    "test:sse-matrix": "node --test scripts/shared-sse.test.mjs scripts/shared-sse-lifecycle.test.mjs scripts/sse-fault-matrix.test.mjs backend/test/sse-replay-subscription.test.js",
    "test:auth-matrix": "node --test scripts/shared-session-token.test.mjs scripts/shared-auth-state.test.mjs scripts/auth-session.test.mjs scripts/auth-failure-matrix.test.mjs host/test/auth-state.test.mjs",
    "test:trusted-types": "node --test scripts/shared-safe-dom.test.mjs scripts/writer-modal-templates.test.mjs scripts/director-modal-templates.test.mjs scripts/trusted-types-contract.test.mjs backend/test/security-headers.test.js",
    "test:clue-flow": "node --test scripts/clue-flow-view.test.mjs",
    "test:pipeline-session": "node --test scripts/pipeline-wizard-session.test.mjs",
    "generate:matrix-pilot": "node backend/scripts/generate-matrix-pilot-example.mjs",
    "smoke:matrix-layer": "node backend/scripts/matrix-layer-smoke.mjs",
    "render:matrix-pilot-review": "node backend/scripts/render-matrix-pilot-review.mjs",
    "test:play": "npm run build --prefix play && node --test play/test/*.test.mjs",
    "test:host": "npm run build --prefix host && node --test host/test/*.test.mjs",
    "test:permissions-matrix": "npm run test:permissions-matrix --prefix backend",
    "drill:l1": "node scripts/run-l1-drills.mjs",
    "drill:oncall": "node scripts/monitoring-oncall-drill.mjs",
    "drill:beta-support": "npm run drill:beta-support --prefix backend",
    "dev:host": "npm run dev --prefix host",
    "explore:ai": "node e2e/ai-explore.mjs",
    "explore:ai:llm": "node e2e/ai-explore.mjs --llm --headed",
    "ensure:esm": "node scripts/ensure-esm-exports.mjs",
    "capture:site-screenshots": "playwright test e2e/capture-site-screenshots.spec.js --project=app-chromium",
    "test:site-screenshots": "node --test scripts/site-screenshots.test.mjs",
    "git:push": "node scripts/git-push.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@playwright/test": "^1.61.1",
    "vite": "^8.1.3"
  }
}
