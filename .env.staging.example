# Copy to .env.staging — used by docker compose and staging smoke tests.

# Required when project folder name is non-ASCII (Windows); npm scripts also pass -p zhimu-staging
COMPOSE_PROJECT_NAME=zhimu-staging

STAGING_HTTP_PORT=8080
STAGING_BASE_URL=http://localhost:8080

POSTGRES_PASSWORD=replace_me_staging

# Must match how users reach the site (scheme + host + port).
CORS_ORIGIN=http://localhost:8080

# First deploy only: seed demo world + exploration data.
RUN_DB_SEED=true

# Vite staging build (baked into dist/)
VITE_REQUIRE_AUTH=true
VITE_DEMO_MODE=false
VITE_API_BASE=/api

LOG_FORMAT=json
LOG_LEVEL=info

# Optional object storage (attachments). Leave empty to skip uploads in staging.
OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_ENDPOINT=
