# =============================================================================
# 织幕 · Docker 预发环境变量模板
# =============================================================================
# 使用方式（项目根目录）：
#   Copy-Item .env.staging.example .env.staging
# 填入下方空位后：
#   npm run build:staging
#   npm run staging:up
# 浏览器访问：http://localhost:8080 （或你改的 STAGING_HTTP_PORT）
# =============================================================================

# Windows 中文路径项目名时建议保留
COMPOSE_PROJECT_NAME=zhimu-staging

# --- 访问地址（本机 Docker 一般不用改）---
STAGING_HTTP_PORT=8080
STAGING_BASE_URL=http://localhost:8080
# 必须与浏览器地址一致（scheme + host + port）
CORS_ORIGIN=http://localhost:8080

# --- 数据库（Compose 内 Postgres，只需改密码）---
POSTGRES_PASSWORD=

# 首次部署 true（写入 CI 测试桩等）；之后改 false;
RUN_DB_SEED=true

# --- 前端构建（写入 dist/，强制登录、无 demo 模式）---
VITE_REQUIRE_AUTH=true
VITE_DEMO_MODE=false
VITE_API_BASE=/api

# --- API 日志 ---
LOG_FORMAT=json
LOG_LEVEL=info
# 预发必须覆盖“新房默认冻结”路径；生产仅在三端故障矩阵验收后开启。
ROOM_DEFAULT_CONTENT_BINDING=latest_release

# =============================================================================
# Cloudflare R2 · 内容资产 ← 填写
# =============================================================================
OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 必须与生产 bucket 不同；sync-staging-env 默认写 ${R2_BUCKET}-staging，或设 R2_BUCKET_STAGING=
R2_BUCKET=
R2_BUCKET_STAGING=
R2_PUBLIC_ENDPOINT=

# =============================================================================
# DeepSeek · AI 创作 ← 填写
# =============================================================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=120000

# =============================================================================
# LiveKit · 语音连麦 ← 填写
# =============================================================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# =============================================================================
# Resend · 找回密码（功能开发中，可先填好）← 填写
# =============================================================================
RESEND_API_KEY=
MAIL_FROM=
# 预发重置链接跳转地址（与 STAGING_BASE_URL 一致）
APP_PUBLIC_URL=http://localhost:8080

# =============================================================================
# 运维（可选）
# =============================================================================
# OPS_API_TOKEN=
# METRICS_TOKEN=
