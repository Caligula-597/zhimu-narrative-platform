# Frontend build (production)
VITE_API_BASE=/api

# Vite dev only — proxy target for /api
# VITE_API_PROXY_TARGET=http://localhost:4180
# Standalone `node server.js --dist` proxy target (origin, without /api)
# API_PROXY_TARGET=http://127.0.0.1:4180
# VITE_DEV_PORT=4173
# VITE_DEV_HOST=false   # set false to bind localhost only; default allows LAN (--host)
