# =============================================================================
# 织幕后端 · 本地开发环境变量模板
# =============================================================================
# 使用方式（在 backend 目录）：
#   Copy-Item .env.example .env
# 然后填入下方带「← 填写」标记的空位。勿提交 .env 到 Git。
# =============================================================================

# --- 服务基础 ---
PORT=4180
NODE_ENV=development
# TRUST_PROXY_HOPS=1
# APP_INSTANCE_COUNT=1
# EDGE_RATE_LIMIT_VERIFIED=false
# HTTP_REQUEST_TIMEOUT_MS=120000
# SESSION_LAST_SEEN_TOUCH_SECONDS=300
# Production defaults to one day unless explicitly shortened further.
# SESSION_TTL_DAYS=1
# GUEST_SESSION_TTL_DAYS=1

# 本地开发可 true（配合 x-user-id 调试）；预发/生产必须 false
# NODE_ENV=production 且此项 true 时进程会 FATAL 拒绝启动
ALLOW_DEMO_USER_HEADER=true

# 官方示例（生产/预发填写已审核并公开上架的剧本 UUID；本地默认可不填）
# OFFICIAL_EXAMPLE_WORLD_ID=<approved-catalog-world-uuid>

# --- 数据库（本地 Postgres 或 Docker）---
DATABASE_URL=postgresql://zhimu:replace_me@localhost:5432/zhimu
DATABASE_SSL=false
# Production TLS verifies the server certificate. Set the PEM only when the
# provider CA is not already trusted by the Node runtime.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Local troubleshooting only. Production refuses to start when verification
# is disabled; configure DATABASE_SSL_CA with the provider certificate instead.
# DATABASE_SSL_VERIFY=false
# 会话池 15 连接规格建议每实例 6：允许滚动部署双实例，并为迁移/运维保留 3 个连接。
# PGPOOL_MAX=6
# PGPOOL_IDLE_MS=30000
# PGPOOL_CONNECTION_TIMEOUT_MS=10000
# PGPOOL_MAX_LIFETIME_SECONDS=1800
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# SSE event bus: production defaults to postgres; use memory only for single-process local development.
# ROOM_EVENTS_BUS=memory
# SSE_MAX_BUFFERED_BYTES=1048576
# 新私有运行房的默认内容来源：live_draft（灰度关闭）或 latest_release（默认冻结）。
# 显式 releaseId=null 仍可创建私有联调房；公开房始终要求 Release。
# ROOM_DEFAULT_CONTENT_BINDING=live_draft

# 跨域（前后端不同域时填写；本地 Vite 代理一般不用改）
# CORS_ORIGIN=http://localhost:4173

# =============================================================================
# Cloudflare R2 · 内容资产上传（线索图、音频等）← 填写
# =============================================================================
OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_ENDPOINT=
SIGNED_UPLOAD_TTL_SECONDS=600
SIGNED_DOWNLOAD_TTL_SECONDS=300
RECYCLE_BIN_DAYS=14

# =============================================================================
# DeepSeek · 平台系统任务（用户创作默认使用自备 API）
# =============================================================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=180000
OUTLINE_BATCH_CONCURRENCY=10
# 每篇完整草稿最多从零重写次数；机械硬门禁失败不会 patch 旧稿
OUTLINE_FULL_DRAFT_ATTEMPTS=1
OUTLINE_BLUEPRINT_ATTEMPTS=3
OUTLINE_ASSEMBLY_ATTEMPTS=3
OUTLINE_REQUEST_TIMEOUT_MS=240000
OUTLINE_SIMILARITY_ENFORCEMENT=review
OUTLINE_FIELD_SIMILARITY_THRESHOLD=0.78
OUTLINE_COMPOSITE_SIMILARITY_THRESHOLD=0.72
PLATFORM_LLM_USER_ACCESS=false

# Optional Feishu/Lark manuscript import. Grant the app read access from the
# document's “Add document app” menu before importing. Tokens are never sent
# to the browser or persisted with imported content.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional short-lived user token for development only; prefer app credentials.
FEISHU_USER_ACCESS_TOKEN=

# 用户自备 API Key 加密（AES-256-GCM）；生产必填，开发可用 OPS_API_TOKEN 兜底
LLM_CREDENTIALS_SECRET=

# PDF 文档解析（创作者台 · 文档导入）
# 文本层 PDF → 抽字；图片型 PDF / 图片 → 按页上传为分幕图片（玩家翻页阅读）
# PDF_PAGE_IMPORT_MAX_PAGES=40
# PDF_PAGE_RENDER_SCALE=2
# PDF_OCR_ENABLED=false  # 仅当创作者勾选 OCR 或 parseMode=text+allowOcr 时使用
# PDF_OCR_MAX_PAGES=30
# PDF_OCR_SCALE=2
# PDF_OCR_LANG=chi_sim

# --- 剧本压缩包导入（script-bundle）---
# SCRIPT_BUNDLE_MAX_BYTES=52428800
# SCRIPT_BUNDLE_MAX_ENTRIES=500
# SCRIPT_BUNDLE_MAX_UNCOMPRESSED_BYTES=209715200

# =============================================================================
# LiveKit · 玩家语音连麦 ← 填写
# =============================================================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVEKIT_TOKEN_TTL_SECONDS=600
# VOICE_ROOM_ACTIVE_LIMIT=30
# VOICE_PRIVATE_ROOM_LIFETIME_HOURS=24

# =============================================================================
# 事务邮件 · 找回密码 / 邮箱验证邮件
# =============================================================================
# 邮件服务商：resend | sendgrid | mailgun | smtp | console（仅开发，stdout 打印）
EMAIL_PROVIDER=resend
# https://resend.com → API Keys
RESEND_API_KEY=
# EMAIL_REQUEST_TIMEOUT_MS=15000
# 路线 B SendGrid：https://app.sendgrid.com → Settings → API Keys
# SENDGRID_API_KEY=
# 路线 C Mailgun：https://app.mailgun.com → Sending → Domains
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# 路线 D 企业邮箱 SMTP（阿里企业邮箱示例；使用“三方客户端安全密码”）
# SMTP_HOST=smtp.qiye.aliyun.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@getzhimu.com
# SMTP_PASS=
# 正式：noreply@mail.getzhimu.com（系统发信，勿回复）
MAIL_FROM=织幕 <noreply@mail.getzhimu.com>
# 用户 Support / Reply-To / 默认运营收件
SUPPORT_EMAIL=support@getzhimu.com
MAIL_REPLY_TO=support@getzhimu.com
# 官网对外联络 / 商务咨询
HELLO_EMAIL=hello@getzhimu.com
# 内测 / 公开库 / 套餐升级 / 告警邮件收件
ADMIN_EMAIL=admin@getzhimu.com
# BETA_REVIEW_NOTIFY_EMAIL=admin@getzhimu.com
# CATALOG_REVIEW_NOTIFY_EMAIL=admin@getzhimu.com
# PLAN_UPGRADE_NOTIFY_EMAIL=admin@getzhimu.com
# ALERT_EMAIL=admin@getzhimu.com
# 重置密码 / 邮箱验证链接跳转的前端根地址（本地 dev 前端）
APP_PUBLIC_URL=http://localhost:4173
# 玩家端 / 官网（生产三域部署必填，见 docs/ops/LAUNCH_ENV.md）
# PLAY_SITE_URL=https://play.getzhimu.com
# PLAY_SITE_ORIGIN=https://play.getzhimu.com
# HOST_SITE_URL=https://host.getzhimu.com
# HOST_SITE_ORIGIN=https://host.getzhimu.com
# MARKETING_SITE_URL=https://getzhimu.com
# MARKETING_SITE_ORIGIN=https://getzhimu.com
# 生产公开注册时设为 true（须同时配置邮件服务商）
# REQUIRE_EMAIL_VERIFICATION=false
# Random 32+ byte secret used to HMAC six-digit verification codes.
# EMAIL_VERIFICATION_CODE_SECRET=
# 测试环境捕获邮件链接而不真正发信（勿用于生产）
# EMAIL_DELIVERY_STUB=1

# 见上方「官方示例」；生产可改为已审核剧本 UUID（如 20725d66-… 小示例）

# =============================================================================
# 运维与安全（预发/生产建议填写）
# =============================================================================
# LOG_FORMAT=json
# LOG_LEVEL=info
# OPS_API_TOKEN=
# METRICS_TOKEN=
# OPENAPI_UI=false
# Production must use CSP_MODE=enforce. Development can leave it unset/off.
# CSP_MODE=enforce

# 上传扫描：none | stub | webhook
# UPLOAD_SCAN_MODE=none|stub|builtin|webhook|clamav|strict
# UPLOAD_SCAN_MODE=builtin
# Production must use UPLOAD_SCAN_MODE=strict plus UPLOAD_SCAN_WEBHOOK_URL or UPLOAD_SCAN_CLAMAV_HOST.
# UPLOAD_SCAN_HEAD_BYTES=65536
# UPLOAD_SCAN_STUB_RESULT=clean
# UPLOAD_SCAN_WEBHOOK_URL=
# UPLOAD_SCAN_WEBHOOK_SECRET=
# UPLOAD_SCAN_CLAMAV_HOST=127.0.0.1
# UPLOAD_SCAN_CLAMAV_PORT=3310
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_SECRET=
# ALERT_WEBHOOK_TIMEOUT_MS=15000
# ALERT_CHECK_INTERVAL_MS=60000
# TRUSTED_TYPES_REPORT_ONLY=true
# TRUSTED_TYPES_ENFORCE=false
# CSP_ALERT_THRESHOLD_PER_MINUTE=20
# MAINTENANCE_MODE=false

# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_RECOVERY_MAX=6
# RATE_LIMIT_VERIFICATION_RESEND_MAX=3
# RETENTION_ACCOUNT_CREATION_EVENTS_DAYS=7
# RETENTION_OPS_USER_AUDIT_DAYS=180
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_WRITE_MAX=120
# RATE_LIMIT_READ_MAX=300
# RATE_LIMIT_UPLOAD_MAX=30
# RATE_LIMIT_UPLOAD_IP_MAX=120
# RATE_LIMIT_DOCUMENT_MAX=10
# RATE_LIMIT_DOCUMENT_IP_MAX=60
# RATE_LIMIT_SCRIPT_BUNDLE_MAX=4
# RATE_LIMIT_SCRIPT_BUNDLE_IP_MAX=20
# RATE_LIMIT_AI_MAX=40
# RATE_LIMIT_AI_IP_MAX=160
# RATE_LIMIT_INVITE_LOOKUP_MAX=30
# RATE_LIMIT_INVITE_LOOKUP_IP_MAX=120
# RATE_LIMIT_ROOM_JOIN_MAX=12
# RATE_LIMIT_ROOM_JOIN_IP_MAX=80
# RATE_LIMIT_VOICE_READ_MAX=120
# RATE_LIMIT_VOICE_READ_IP_MAX=600
# RATE_LIMIT_VOICE_MESSAGE_MAX=20
# RATE_LIMIT_VOICE_MESSAGE_IP_MAX=240
# RATE_LIMIT_VOICE_TOKEN_MAX=10
# RATE_LIMIT_VOICE_TOKEN_IP_MAX=120
# RATE_LIMIT_VOICE_CREATE_MAX=5
# RATE_LIMIT_VOICE_CREATE_IP_MAX=60
# RATE_LIMIT_VOICE_INVITE_MAX=10
# RATE_LIMIT_VOICE_INVITE_IP_MAX=120
# RATE_LIMIT_CHECKPOINT_CREATE_MAX=5
# RATE_LIMIT_CHECKPOINT_CREATE_IP_MAX=30
# RATE_LIMIT_CHECKPOINT_RESTORE_MAX=3
# RATE_LIMIT_CHECKPOINT_RESTORE_IP_MAX=20
# RATE_LIMIT_RECAP_CREATE_MAX=2
# RATE_LIMIT_RECAP_CREATE_IP_MAX=20
# RATE_LIMIT_HOST_LOG_MAX=30
# RATE_LIMIT_HOST_LOG_IP_MAX=120
# RATE_LIMIT_HOST_NUDGE_MAX=10
# RATE_LIMIT_HOST_NUDGE_IP_MAX=60
# RATE_LIMIT_HOST_PLAYER_NOTES_MAX=30
# RATE_LIMIT_HOST_PLAYER_NOTES_IP_MAX=120
# RATE_LIMIT_HOST_PLAYER_KICK_MAX=10
# RATE_LIMIT_HOST_PLAYER_KICK_IP_MAX=60
# DOCUMENT_PROCESSING_MAX_CONCURRENT=2
# DOCUMENT_PROCESSING_MAX_QUEUED=4
# DOCUMENT_PROCESSING_QUEUE_TIMEOUT_MS=30000
# CONTENT_PACKAGE_PROCESSING_MAX_CONCURRENT=1
# CONTENT_PACKAGE_PROCESSING_MAX_QUEUED=2
# CONTENT_PACKAGE_PROCESSING_QUEUE_TIMEOUT_MS=30000

# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=zhimu-api
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Production must set OTEL_ENABLED=true, OTEL_EXPORTER_OTLP_ENDPOINT, ALERT_WEBHOOK_URL and METRICS_TOKEN.

# --- OAuth（Google / GitHub）---
# 步骤见 docs/ops/OAUTH_SETUP.md · 本地检查：npm run oauth:check
# Google Redirect URI / GitHub Callback（必须一致）：
#   https://app.getzhimu.com/api/auth/oauth/google/callback
#   https://app.getzhimu.com/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_REQUEST_TIMEOUT_MS=15000
# OAUTH_CALLBACK_ORIGIN=   # 默认与 APP_PUBLIC_URL 相同，一般留空
# REQUIRE_OAUTH_IN_PRODUCTION=false

# --- 内测账号提权（可选）---
# INTERNAL_BETA_EMAIL_DOMAINS=zhimu.local,getzhimu.com
# INTERNAL_BETA_EMAILS=alice@example.com,bob@example.com

# --- Stripe 订阅（可选）---
# 商业化总开关；首发保持 false。只有完成资金链路专项验收后才允许改为 true。
BILLING_LAUNCH_ENABLED=false
PRICING_PAGE_MODE=launch
COMMERCIAL_PRICING_PUBLIC=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_REQUEST_TIMEOUT_MS=15000
# STRIPE_PRICE_CREATOR=price_...
# STRIPE_PRICE_STUDIO=price_...
# Webhook 端点：${APP_PUBLIC_URL}/api/billing/stripe/webhook

# --- 织幕积分 / 商业化 UI（首月默认隐藏）---
# CREDITS_SYSTEM_ENABLED=false         # 首发冻结；只有显式 true 才启用记账与月赠
# CREDITS_DEBIT_AI=false             # true 时 AI 请求扣积分；首月建议 false
# CREDITS_UI_VISIBLE=false             # 账号页积分/充值 UI
# CREDITS_UI_VISIBLE_AFTER=2026-08-06  # 到达该日期后自动展示 UI（ISO 日期）
# CREDITS_AI_COST=5
# COMMERCIAL_PRICING_PUBLIC=false      # 官网标价草案链接

# --- 玩家广场 / 私信内容审核 ---
# 文档：docs/ops/PLAY_CONTENT_MODERATION.md
# PLAY_PLAZA_AI_REVIEW=ai
# PLAY_SOCIAL_REQUIRE_VERIFIED_EMAIL=true
# PLAY_SOCIAL_ACCOUNT_COOLDOWN_MIN=10
# GUEST_CREATE_HOUR_MAX=3
# GUEST_CREATE_DAY_MAX=8
# REGISTER_IP_DAY_MAX=5   # set 0 to disable per-IP registration cap (tests use 0 via test/hooks.mjs)
# RATE_LIMIT_GUEST_AUTH_MAX=8
# RETENTION_VOICE_MESSAGES_DAYS=90
# DATA_RETENTION_INTERVAL_MS=86400000
# ACCOUNT_DELETE_JOB_INTERVAL_MS=300000
# PLAZA_REVIEW_INTERVAL_MS=60000
# PLAY_CONTENT_EXTRA_BLOCK_TERMS=词条甲,词条乙
# PLAY_CONTENT_BLOCKLIST_PATH=
