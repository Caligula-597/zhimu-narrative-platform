PORT=4180
NODE_ENV=development
# Local frontend demo uses x-user-id; set true for localhost development only.
# NEVER set true when NODE_ENV=production — startup will FATAL exit.
ALLOW_DEMO_USER_HEADER=true
DATABASE_URL=postgresql://zhimu:replace_me@localhost:5432/zhimu
DATABASE_SSL=false
# Connection pool (default max 10)
# PGPOOL_MAX=10
# PGPOOL_IDLE_MS=30000
# SSE fan-out across API instances: memory (default) | postgres (LISTEN/NOTIFY)
# ROOM_EVENTS_BUS=postgres
# Production CORS — comma-separated origins, or * for reflect-any (not recommended)
# CORS_ORIGIN=https://app.example.com
OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_ENDPOINT=
SIGNED_UPLOAD_TTL_SECONDS=600
SIGNED_DOWNLOAD_TTL_SECONDS=300
RECYCLE_BIN_DAYS=14
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Ops & observability (production)
# LOG_FORMAT=json
# LOG_LEVEL=info
# OPS_API_TOKEN=long-random-secret-for-ops-endpoints
# METRICS_TOKEN=optional-scrape-secret-for-/metrics
# OPENAPI_UI=false
# UPLOAD_SCAN_MODE=none
# UPLOAD_SCAN_STUB_RESULT=clean
# UPLOAD_SCAN_WEBHOOK_URL=
# UPLOAD_SCAN_WEBHOOK_SECRET=
# Rate limits (production defaults shown)
# RATE_LIMIT_UPLOAD_MAX=30
# RATE_LIMIT_AI_MAX=40
# OpenTelemetry (optional — full SDK wiring is ops-managed)
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=zhimu-api
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_DEBUG=false
