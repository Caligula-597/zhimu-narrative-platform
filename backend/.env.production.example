# =============================================================================
# 织幕 · 生产环境变量模板（backend）
# =============================================================================
# 使用方式：
#   1. 复制为 backend/.env（或托管平台的环境变量面板）
#   2. 逐项填写下方空位
#   3. 对照 docs/ops/COMMERCIAL_EXTERNAL_SERVICES.md 完成外部服务注册
# 勿提交含真实密钥的 .env 到 Git。
# =============================================================================

NODE_ENV=production
PORT=4180
ALLOW_DEMO_USER_HEADER=false

# --- 数据库（路线 A：托管 Postgres；路线 B：自建 Docker Postgres）---
DATABASE_URL=
DATABASE_SSL=true

# 前端公网地址（CORS + 邮件链接）
APP_PUBLIC_URL=
# CORS_ORIGIN=

# --- 邮件（路线 A Resend / B SendGrid / C Mailgun；开发可用 console）---
EMAIL_PROVIDER=resend
REQUIRE_EMAIL_VERIFICATION=true
MAIL_FROM=
RESEND_API_KEY=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# --- 对象存储（路线 A Cloudflare R2 / B AWS S3 兼容）---
OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_ENDPOINT=
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- AI（路线 A DeepSeek / B OpenAI 兼容网关）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- 语音（路线 A LiveKit Cloud / B 自建 LiveKit）---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- 运维 ---
OPS_API_TOKEN=
# METRICS_TOKEN=
LOG_FORMAT=json
LOG_LEVEL=info
OPENAPI_UI=false
UPLOAD_SCAN_MODE=none

# --- 限流（可按流量调整）---
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_AI_MAX=40

# --- 可观测（路线 A Sentry / B 自建 OTEL）---
# SENTRY_DSN=
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- OAuth（Phase 2，预留）---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- 支付（Phase 4，预留）---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
