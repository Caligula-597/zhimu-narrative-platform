{
  "name": "zhimu-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "bootstrap:local": "node scripts/bootstrap-local.js",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "demo:create-cloud-story": "node scripts/create-cloud-demo-story.js",
    "demo:seed-exploration": "node scripts/seed-exploration.js",
    "demo:bootstrap-e2e-room": "node scripts/bootstrap-e2e-room.mjs",
    "demo:reset-e2e-room": "node scripts/reset-e2e-room.mjs",
    "demo:reset-fog-e2e": "node scripts/reset-fog-e2e.mjs",
    "demo:seed-voice-participants": "node scripts/seed-demo-voice-participants.js",
    "assets:purge": "node scripts/purge-deleted-assets.js",
    "assets:cleanup-uploads": "node scripts/cleanup-expired-uploads.js",
    "check": "node scripts/verify-modules.mjs",
    "check:syntax": "node scripts/verify-modules.mjs",
    "check:modules": "node scripts/verify-modules.mjs",
    "check:boot": "node scripts/verify-boot.mjs",
    "check:tests": "node scripts/verify-test-count.mjs",
    "check:schemas": "node scripts/verify-route-schemas.mjs",
    "db:backup": "node scripts/pg-backup.mjs",
    "test": "node --test-concurrency=1 --test-force-exit --test test/*.test.js",
    "test:smoke": "node scripts/smoke-api.js",
    "test:ui": "node ../scripts/ui-smoke.js",
    "verify:full": "node ../scripts/full-chain.mjs",
    "test:ui:load": "node ../scripts/verify-script-load.mjs",
    "ci": "npm run db:migrate && npm run db:seed && npm run demo:seed-exploration && npm run check && npm run check:boot && npm run check:tests && npm test && npm run test:smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "livekit-server-sdk": "^2.15.4",
    "mammoth": "^1.12.0",
    "pg": "^8.16.3"
  }
}
